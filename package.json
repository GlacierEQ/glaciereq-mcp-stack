{
  "name": "glaciereq-mcp-stack",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -b packages/*/tsconfig.json",
    "build:watch": "tsc -b packages/*/tsconfig.json --watch",
    "start:asana": "node packages/asana-mcp/dist/index.js",
    "start:github": "node packages/github-mcp/dist/index.js",
    "start:confluence": "node packages/confluence-mcp/dist/index.js",
    "start:supabase": "node packages/supabase-mcp/dist/index.js",
    "start:neo4j": "node packages/neo4j-mcp/dist/index.js",
    "start:all": "concurrently \"npm run start:asana\" \"npm run start:github\" \"npm run start:confluence\" \"npm run start:supabase\" \"npm run start:neo4j\""
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0"
  }
}
