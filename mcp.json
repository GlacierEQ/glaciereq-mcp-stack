{
  "mcpServers": {
    "asana": {
      "command": "node",
      "args": ["packages/asana-mcp/dist/index.js"],
      "env": { "ASANA_API_TOKEN": "${ASANA_API_TOKEN}" }
    },
    "github": {
      "command": "node",
      "args": ["packages/github-mcp/dist/index.js"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_USER": "${GITHUB_USER}"
      }
    },
    "confluence": {
      "command": "node",
      "args": ["packages/confluence-mcp/dist/index.js"],
      "env": {
        "CONFLUENCE_API_KEY": "${CONFLUENCE_API_KEY}",
        "CONFLUENCE_BASE_URL": "${CONFLUENCE_BASE_URL}",
        "CONFLUENCE_EMAIL": "${CONFLUENCE_EMAIL}"
      }
    },
    "supabase": {
      "command": "node",
      "args": ["packages/supabase-mcp/dist/index.js"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "neo4j": {
      "command": "node",
      "args": ["packages/neo4j-mcp/dist/index.js"],
      "env": {
        "NEO4J_URI": "${NEO4J_URI}",
        "NEO4J_USERNAME": "${NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "${NEO4J_DATABASE}"
      }
    }
  }
}
